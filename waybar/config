{
    // "layer": "top", // Waybar at top layer
    // "position": "bottom", // Waybar position (top|bottom|left|right)
    "height": 38, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 4, // Gaps between modules (4px)
    // Choose the order of the modules
    "modules-left": ["hyprland/workspaces", "custom/librewolf-default", "custom/firefox-Super-Default", "custom/firefox-youtube", "custom/firefox-TV","custom/firefox-Other", "custom/pinger", "custom/1min","custom/5min","custom/15min", "custom/weather", "custom/oil"],
    "modules-center": ["clock"],
    "modules-right": ["custom/gold","custom/vix","custom/tnx","custom/Ping_GW","custom/Ping_fios", "custom/Ping_firewall", "idle_inhibitor", "custom/clearmako", "pulseaudio", "memory", "temperature", "tray"],
    // Modules configuration
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "tray": {
        // "icon-size": 21,
        "spacing": 10
    },
    "clock": {
        // "timezone": "America/New_York",
        "format": "{:%H %M %a %m %d %y}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}"
    },
    "memory": {
        "format": "{}% "
    },
    "temperature": {
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        // "format-critical": "{temperatureC}°C {icon}",
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["", "", ""]
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{volume}% {icon} {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },
    "custom/firefox-Super-Default": {
        "format": "",
        "on-click": "firefox -P Super-Default",
        "on-click-right": "firefox --ProfileManager"
    },
    "custom/firefox-youtube": {
        "format": "",
        "on-click": "firefox -P Youtube",
        "on-click-right": "firefox --ProfileManager"
    },
    "custom/firefox-TV": {
        "format": "",
        "on-click": "firefox -P TV",
        "on-click-right": "firefox --ProfileManager"
    },
    "custom/firefox-Other": {
        "format": "",
        "on-click": "firefox -P LastPass",
        "on-click-right": "firefox --ProfileManager"
    },
    "custom/librewolf-default": {
        "format": "",
        "on-click": "/usr/bin/librewolf -P Super-Default",
        "on-click-right": "/usr/bin/librewolf --ProfileManager"
    },
    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1"
    },
    "custom/pinger": {
        "exec" : "~/.config/waybar/scripts/pinger.sh",
        "format":"{icon} {0}",
        "interval": 10,
        "return-type": "json",
        "min-length": 4,
        "format-icons": {
            "default": "",
            "low":""
        }
    },
   "custom/1min": {
        "exec" : "cut -f1 -d' ' /proc/loadavg",
        "format":"{icon} {0}",
        "interval": 10,
        "min-length": 4,
        "format-icons": {
            "default": "",
            "low":""
        }
    },
    "custom/5min": {
        "exec" : "cut -f2 -d' ' /proc/loadavg",
        "format":"{icon} {0}",
        "interval": 10,
        "min-length": 4,
        "format-icons": {
            "default": "",
            "low":""
        }
    },
    "custom/15min": {
        "exec" : "cut -f3 -d' ' /proc/loadavg",
        "format":"{icon} {0}",
        "interval": 10,
        "min-length": 4,
        "format-icons": {
            "default": "",
            "low":""
        }
    },
    "custom/Ping_firewall": {
      "exec" : "~/.config/waybar/scripts/ping_host.sh 192.168.2.1 21",
      "format":"{icon} {0}",
      "return-type": "json",
      "interval": 10,
      "min-length": 4,
      "format-icons": {
          "default": "",
          "low":""
      }
    },
    "custom/Ping_fios": {
      "exec" : "~/.config/waybar/scripts/ping_host.sh 192.168.1.1 11",
      "format":"{icon} {0}",
      "return-type": "json",
      "interval": 10,
      "min-length": 4,
      "format-icons": {
          "default": "",
          "low":""
      }
    },
    "custom/Ping_GW": {
      "exec" : "~/.config/waybar/scripts/ping_host.sh 108.44.37.1 GW",
      "format":"{icon} {0}",
      "return-type": "json",
      "interval": 10,
      "min-length": 4,
      "format-icons": {
          "default": "",
          "low":""
      }
    },
    "custom/clearmako": {
        "format": "🔊",
        "on-click": "makoctl dismiss --all"
    },
    "custom/weather": {
        "exec": "~/.config/waybar/scripts/OPENWEATHER.sh",
        "return-type": "json",
        "interval": 700,
        "tooltip": true
    },
    "custom/oil": {
    "exec": "~/.config/waybar/scripts/market_indicator.sh CL=F 🛢️ 'WTI Crude' oil '' dollar",
    "return-type": "json",
    "interval": 300,
    "tooltip": true,
    "min-length": 16
    },
    "custom/gold": {
        "exec": "~/.config/waybar/scripts/market_indicator.sh GC=F 🪙 Gold gold '' dollar",
        "return-type": "json",
        "interval": 300,
        "tooltip": true,
        "min-length": 16
    },
    "custom/vix": {
        "exec": "~/.config/waybar/scripts/market_indicator.sh ^VIX 😰 VIX vix invert index",
        "return-type": "json",
        "interval": 300,
        "tooltip": true,
        "min-length": 14
    },
    "custom/tnx": {
        "exec": "~/.config/waybar/scripts/market_indicator.sh ^TNX 📈 '10Y Yield' tnx '' pct",
        "return-type": "json",
        "interval": 300,
        "tooltip": true,
        "min-length": 14
    }
}
