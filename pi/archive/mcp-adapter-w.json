{
  "mcpServers": {
     "exa": {
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "x-api-key": "${EXA_API_KEY}"
      },
      "directTools": true
    },
    "time": {
      "command": "uvx",
      "args": ["mcp-server-time", "--local-timezone=America/New_York"]
    },
    "yahoo-finance": {
      "url": "https://gateway.mcpservers.org/yahoo-finance/mcp",
      "type": "http"
    }
  }
}
