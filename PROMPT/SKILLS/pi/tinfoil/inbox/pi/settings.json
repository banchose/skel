{
  "theme": "dark",
  "terminal": {
    "trueColor": true
  },
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:@narumitw/pi-btw",
    "npm:@narumitw/pi-stamp"
  ],
  "defaultProvider": "amazon-bedrock",
  "defaultModel": "us.anthropic.claude-opus-5-5",
  "workingVibe": "star trek",
  "defaultThinkingLevel": "high",
  "modelThinkingLevels": {
    "tinfoil/glm-5-3": "xhigh",
    "tinfoil/deepseek-v4-1-flash": "xhigh",
    "anthropic/claude-opus-5-5": "high"
  },
  "enabledModels": [
    "amazon-bedrock/us.anthropic.claude-opus-5-5",
    "anthropic/claude-opus-5-5",
    "anthropic/claude-sonnet-5-5",
    "anthropic/claude-fable-5-1",
    "tinfoil/kimi-k3",
    "tinfoil/glm-5-3",
    "tinfoil/deepseek-v4-1-flash"
  ],
  "extensions": [
    "-builtin:mcp"
  ]
}
